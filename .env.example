# Postgres (compose defaults)
POSTGRES_DB=nmcc
POSTGRES_USER=nmcc
POSTGRES_PASSWORD=nmcc
# If another Postgres already binds 5432 on the host, use e.g. 5437 and match DATABASE_URL.
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://nmcc:nmcc@localhost:5432/nmcc
API_PORT=3000
NUXT_HOST=0.0.0.0
NUXT_PORT=3000
# Compose image tag (local build default nmcc-api; GHCR e.g. ghcr.io/<owner>/nmcc-api:main)
# DOCKER_IMAGE_API=nmcc-api


# Better Auth (required in real deployments — change the secret)
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
# Browser on the same machine: localhost. Phone on Wi-Fi: http://<lan-ip>:3000 (see doc/local-development.md).
BETTER_AUTH_URL=http://localhost:3000
# Optional: only this email may register as the first admin on an empty instance
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Shared lists seed (ARCEP MAJNUM — Licence Ouverte 2.0)
# ARCEP_MAJNUM_URL=https://extranet.arcep.fr/uploads/MAJNUM.csv
# ARCEP_SEED_FIXTURE=1

# Call-event retention (days); older rows purged/omitted from stats + admin feed
EVENTS_RETENTION_DAYS=90

# cda-design-loop (web UI captures — site + admin, not Android)
# DEV_URL_SITE=http://127.0.0.1:3000
# DEV_URL_ADMIN=http://127.0.0.1:3001
# DESIGN_ADMIN_EMAIL=admin@example.com
# DESIGN_ADMIN_PASSWORD=AdminPass123!

# Admin Nuxt (@nmcc/admin) — proxies /api to the API
# ADMIN_URL=http://localhost:3001
# API_PROXY_TARGET=http://127.0.0.1:3000
# NUXT_PUBLIC_API_BASE=
