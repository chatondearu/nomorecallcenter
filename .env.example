# Postgres (compose defaults)
POSTGRES_DB=nmcc
POSTGRES_USER=nmcc
POSTGRES_PASSWORD=nmcc
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://nmcc:nmcc@localhost:5432/nmcc
API_PORT=3000
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Better Auth (required in real deployments — change the secret)
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
# Optional: only this email may register as the first admin on an empty instance
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Shared lists seed (ARCEP MAJNUM — Licence Ouverte 2.0)
# ARCEP_MAJNUM_URL=https://extranet.arcep.fr/uploads/MAJNUM.csv
# ARCEP_SEED_FIXTURE=1

# Call-event retention (days); older rows purged/omitted from stats + admin feed
EVENTS_RETENTION_DAYS=90
